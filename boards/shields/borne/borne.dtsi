#include <dt-bindings/zmk/matrix_transform.h>
#include "borne-layouts.dtsi"

#include <st/f4/stm32f401Xc.dtsi>
#include <st/f4/stm32f401r(b-c)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {

    model = "borne";
    compatible = "st,stm32f401";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,code-partition = &slot0_partition;
        zmk,kscan = &kscan;
    };

    wired_split {
        compatible = "zmk,wired-split";
        device = <&usart1>;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
    };

    left_encoder: left_encoder {
        compatible = "alps,ec11";
        label = "LEFT_ENCODER";
        a-gpios = <&gpiob 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpiob 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        resolution = <2>;
    };

    right_encoder: right_encoder {
        compatible = "alps,ec11";
        label = "RIGHT_ENCODER";
        a-gpios = <&gpiob 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpiob 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        resolution = <2>;
    };

    sensors {
      compatible = "zmk,keymap-sensors";
      sensors = <&left_encoder &right_encoder>;
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;

        map = <
            RC(0, 0) RC(0, 1) RC(0, 2) RC(0, 3) RC(0, 4) RC(0, 5)                      RC(0, 8) RC(0, 9)  RC(0, 10) RC(0, 11) RC(0, 12) RC(0, 13)
            RC(1, 0) RC(1, 1) RC(1, 2) RC(1, 3) RC(1, 4) RC(1, 5) RC(1, 6)    RC(1, 7) RC(1, 8) RC(1, 9)  RC(1, 10) RC(1, 11) RC(1, 12) RC(1, 13)
            RC(2, 0) RC(2, 1) RC(2, 2) RC(2, 3) RC(2, 4) RC(2, 5) RC(2, 6)    RC(2, 7) RC(2, 8) RC(2, 9)  RC(2, 10) RC(2, 11) RC(2, 12) RC(2, 13)
            RC(3, 0) RC(3, 1) RC(3, 2) RC(3, 3) RC(3, 4) RC(3, 5) RC(3, 6)    RC(3, 7) RC(3, 8) RC(3, 9)  RC(3, 10) RC(3, 11) RC(3, 12) RC(3, 13)
                                                RC(4, 3) RC(4, 4) RC(4, 5)    RC(4, 8) RC(4, 9) RC(4, 10)
        >;
    };
};

&flash0 {
  partitions {
    compatible = "fixed-partitions";
    #address-cells = < 0x1 >;
    #size-cells = < 0x1 >;
    slot0_partition: partition@10000 {
      label = "image-0";
      reg = < 0x10000 0x30000 >;
    };
  };
};

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
  status="ok";
};

&clk_hse {
    clock-frequency = <DT_FREQ_M(16)>; 
    status = "okay";
};

&pll {
    clocks = <&clk_hse>;             
    div-m = <16>;                    
    mul-n = <192>;                   
    div-p = <4>;                     
    div-q = <4>;                     
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <DT_FREQ_M(48)>; 
    ahb-prescaler = <1>;               
    apb1-prescaler = <4>;              
    apb2-prescaler = <2>;              
};

&pinctrl {
    /* Define the physical pin configurations for MCO1 and MCO2 */
    rcc_mco1_pa8: rcc_mco1_pa8 {
        pinmux = <STM32_PINMUX('A', 8, AF0)>; /* PA8 Alternate Function 0 */
        bias-disable;
        drive-push-pull;
        slew-rate = "very-high-speed";
    };

    rcc_mco2_pc9: rcc_mco2_pc9 {
        pinmux = <STM32_PINMUX('C', 9, AF0)>; /* PC9 Alternate Function 0 */
        bias-disable;
        drive-push-pull;
        slew-rate = "very-high-speed";
    };
};

&mco1 {
    clocks = <&rcc STM32_SRC_HSI MCO1_SEL(3)>;
    clock-names = "clksel";
    pinctrl-0 = <&rcc_mco1_pa8>;
    pinctrl-names = "default";
    prescaler = <MCO1_PRE(MCO_PRE_DIV_1)>;
    status = "okay";
};

&mco2 {
    clocks = <&rcc STM32_SRC_SYSCLK MCO2_SEL(0)>;
    clock-names = "clksel";
    pinctrl-0 = <&rcc_mco2_pc9>;
    pinctrl-names = "default";
    prescaler = <MCO2_PRE(MCO_PRE_DIV_5)>;
    status = "okay";
};

&plli2s {
    mul-n = <192>;
    div-r = <5>;
    status = "okay";
};

&rtc {
    clocks = <&rcc 0x40 0x10000000>, 
             <&rcc 0x03 0x10c80070>;
    status = "okay";
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	status = "okay";
	current-speed = <115200>;
};
