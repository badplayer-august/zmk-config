#include <dt-bindings/zmk/matrix_transform.h>
#include "borne-layouts.dtsi"

#include <st/f4/stm32f401Xc.dtsi>
#include <st/f4/stm32f401r(b-c)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/delete-node/ &flash0;

/ {
    model = "borne";
    compatible = "borne";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,code-partition = &code_partition;
        zmk,physical-layout = &default_layout;
    };

    wired_split {
        compatible = "zmk,wired-split";
        device = <&usart1>;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;

        map = <
            RC(0, 0) RC(0, 1) RC(0, 2) RC(0, 3) RC(0, 4) RC(0, 5)                      RC(0, 8) RC(0, 9)  RC(0, 10) RC(0, 11) RC(0, 12) RC(0, 13)
            RC(1, 0) RC(1, 1) RC(1, 2) RC(1, 3) RC(1, 4) RC(1, 5) RC(1, 6)    RC(1, 7) RC(1, 8) RC(1, 9)  RC(1, 10) RC(1, 11) RC(1, 12) RC(1, 13)
            RC(2, 0) RC(2, 1) RC(2, 2) RC(2, 3) RC(2, 4) RC(2, 5) RC(2, 6)    RC(2, 7) RC(2, 8) RC(2, 9)  RC(2, 10) RC(2, 11) RC(2, 12) RC(2, 13)
            RC(3, 0) RC(3, 1) RC(3, 2) RC(3, 3) RC(3, 4) RC(3, 5) RC(3, 6)    RC(3, 7) RC(3, 8) RC(3, 9)  RC(3, 10) RC(3, 11) RC(3, 12) RC(3, 13)
                                                RC(4, 3) RC(4, 4) RC(4, 5)    RC(4, 8) RC(4, 9) RC(4, 10)                                        
        >;
    };
};

&flash {
  flash0: flash@8010000{
    reg = < 0x8010000 0x30000 >;
    partitions {
      compatible = "fixed-partitions";
      #address-cells = <1>;
      #size-cells = <1>;

      code_partition: partition@0 {
        label = "code_partition";
        reg = <0x00000000 0x00030000>; 
      };
    };
  };
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	status = "okay";
	current-speed = <115200>;
};

&rtc {
	clocks = <&rcc STM32_CLOCK_BUS_APB1 0x10000000>,
		 <&rcc STM32_SRC_LSI RTC_SEL(2)>;
	status = "okay";
};

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};

&clk_lsi {
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(25)>;
	status = "okay";
};

&pll {
	div-m = <25>;
	mul-n = <336>;
	div-p = <4>;
	div-q = <7>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(84)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <1>;
};

&vref {
	status = "okay";
};

&vbat {
	status = "okay";
};
